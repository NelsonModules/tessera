  <keyword>tessera.lloyd</keyword>
  <short_description>Carte de Voronoi apres relaxation de Lloyd.</short_description>
  <syntax><syntax_item>R = tessera.lloyd(sz)</syntax_item><syntax_item>R = tessera.lloyd(sz, cells, iterations, seed)</syntax_item><syntax_item>[R, sites] = tessera.lloyd(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>cells</param_name><param_description>Indication du nombre de sites par dimension (defaut 8).</param_description></param_input_item>
    <param_input_item><param_name>iterations</param_name><param_description>Nombre d'etapes de relaxation vers les centroides (defaut 2).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>Carte d'identifiants de cellules.</param_description></param_output_item><param_output_item><param_name>sites</param_name><param_description>Coordonnees finales des sites dans une matrice cells-par-2, en pixels.</param_description></param_output_item></param_output>
  <description><p>Deplace les sites de Voronoi vers leurs centroides, puis renvoie la carte d'identifiants de cellules.</p>
  <p><img src="../images/lloyd.svg" align="middle" /></p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[R = tessera.lloyd(128, 12, 3, 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
