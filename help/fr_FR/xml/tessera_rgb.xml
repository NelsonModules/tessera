  <language>fr_FR</language>
  <keyword>tessera.rgb</keyword>
  <short_description>Convertir un champ scalaire en RGB.</short_description>
  <syntax><syntax_item>RGB = tessera.rgb(field)</syntax_item><syntax_item>RGB = tessera.rgb(field, cmap)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>field</param_name><param_description>Champ scalaire, generalement normalise dans [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>cmap</param_name><param_description>Matrice de colormap ou nom de colormap (defaut terrain).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>RGB</param_name><param_description>Tableau RGB avec une derniere dimension de longueur 3.</param_description></param_output_item></param_output>
  <description><p>Borne un champ scalaire dans [0, 1], indexe une colormap et renvoie directement l'image RGB.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[R = tessera.rgb(tessera.fbm(256, 'seed', 1), 'terrain');
imshow(R)]]></example_item_data></example_item></examples>
