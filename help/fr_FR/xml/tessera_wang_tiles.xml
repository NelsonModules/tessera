  <keyword>tessera.wang_tiles</keyword>
  <short_description>Identifiants de tuiles de Wang aux aretes compatibles.</short_description>
  <syntax><syntax_item>T = tessera.wang_tiles(sz)</syntax_item><syntax_item>T = tessera.wang_tiles(sz, colors, seed)</syntax_item><syntax_item>T = tessera.wang_tiles(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>colors</param_name><param_description>Nombre de couleurs d'aretes (defaut 3).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>T</param_name><param_description>Identifiants encodant les aretes ouest, est, nord et sud.</param_description></param_output_item></param_output>
  <description><p>Genere une carte de tuiles de Wang dont les couleurs d'aretes adjacentes correspondent par construction.</p>
  <p><img src="../images/wang_tiles.svg" align="middle" /></p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[T = tessera.wang_tiles([32 32], 4, 1);
imagesc(T); axis image off]]></example_item_data></example_item></examples>
