  <keyword>tessera.wavelet_noise</keyword>
  <short_description>Bruit passe-bande de style ondelette.</short_description>
  <syntax><syntax_item>R = tessera.wavelet_noise(sz)</syntax_item><syntax_item>R = tessera.wavelet_noise(sz, octaves, seed)</syntax_item><syntax_item>R = tessera.wavelet_noise(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>octaves</param_name><param_description>Nombre de differences d'octaves (defaut 4).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>Champ double normalise dans [0, 1].</param_description></param_output_item></param_output>
  <description><p>Construit un bruit passe-bande en sommant les differences entre octaves voisines de bruit de valeur.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[R = tessera.wavelet_noise(256, 4, 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
