  <language>fr_FR</language>
  <keyword>tessera.perlin3</keyword>
  <short_description>Bruit de gradient Perlin 3D.</short_description>
  <syntax><syntax_item>V = tessera.perlin3(sz)</syntax_item><syntax_item>V = tessera.perlin3(sz, frequency, seed)</syntax_item><syntax_item>V = tessera.perlin3(sz, 'frequency', f, 'seed', s, 'seamless', tf)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille du volume : scalaire ou [rows cols planes].</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Frequence de base (defaut 8).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
    <param_input_item><param_name>seamless</param_name><param_description>Si vrai, les faces opposees du volume correspondent.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>V</param_name><param_description>Volume double rows-par-cols-par-planes normalise dans [0, 1].</param_description></param_output_item></param_output>
  <description><p>Genere un champ Perlin coherent 3D pour textures volumiques ou animation par la troisieme dimension.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[V = tessera.perlin3([64 64 16], 'seed', 3, 'seamless', true);
imagesc(V(:, :, 1)); axis image off]]></example_item_data></example_item></examples>
