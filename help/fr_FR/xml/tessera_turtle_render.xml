  <language>fr_FR</language>
  <keyword>tessera.turtle_render</keyword>
  <short_description>Traceur tortue L-system avec styles.</short_description>
  <syntax><syntax_item>[P, W, C] = tessera.turtle_render(commands, angle, step, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>commands</param_name><param_description>Chaine de commandes du L-systeme.</param_description></param_input_item>
    <param_input_item><param_name>angle</param_name><param_description>Angle de rotation en degres.</param_description></param_input_item>
    <param_input_item><param_name>step</param_name><param_description>Longueur de pas par defaut.</param_description></param_input_item>
    <param_input_item><param_name>width</param_name><param_description>Epaisseur de plume par defaut.</param_description></param_input_item>
    <param_input_item><param_name>color</param_name><param_description>Couleur RGB de plume par defaut.</param_description></param_input_item>
    <param_input_item><param_name>symbol_steps</param_name><param_description>Structure associant un symbole a une longueur de pas.</param_description></param_input_item>
    <param_input_item><param_name>symbol_widths</param_name><param_description>Structure associant un symbole a une epaisseur.</param_description></param_input_item>
    <param_input_item><param_name>symbol_colors</param_name><param_description>Structure associant un symbole a une couleur RGB.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>P</param_name><param_description>Sommets de polylignes, avec des lignes NaN entre les branches.</param_description></param_output_item><param_output_item><param_name>W</param_name><param_description>Epaisseur de chaque sommet.</param_description></param_output_item><param_output_item><param_name>C</param_name><param_description>Couleur RGB de chaque sommet.</param_description></param_output_item></param_output>
  <description><p>Interprete une chaine de commandes avec empilement des branches et styles par symbole. F et G dessinent, f se deplace sans dessiner et &gt; et &lt; modifient l'epaisseur.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[[S, W, C] = tessera.turtle_render('F[+F]F[-F]F', 25, 1, 'width', 2, 'symbol_colors', struct('F', [0.1 0.5 0.2]));
plot(S(:, 1), S(:, 2)); axis equal off]]></example_item_data></example_item></examples>
