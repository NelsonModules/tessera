  <keyword>tessera.gabor_noise</keyword>
  <short_description>Bruit spectral par noyaux de Gabor.</short_description>
  <syntax><syntax_item>R = tessera.gabor_noise(sz)</syntax_item><syntax_item>R = tessera.gabor_noise(sz, impulses, frequency, seed)</syntax_item><syntax_item>R = tessera.gabor_noise(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>impulses</param_name><param_description>Nombre de noyaux (defaut 64).</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Frequence porteuse dominante (defaut 8).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>Champ double normalise dans [0, 1].</param_description></param_output_item></param_output>
  <description><p>Accumule des noyaux de Gabor epars pour un champ de bruit directionnel a frequence dominante controlable.</p>
  <p><img src="../images/gabor_noise.svg" align="middle" /></p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[R = tessera.gabor_noise(256, 96, 12, 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
