  <keyword>tessera.tile_wfc</keyword>
  <short_description>Synthese simple par modele tuile.</short_description>
  <syntax><syntax_item>R = tessera.tile_wfc(sample, outSize)</syntax_item><syntax_item>R = tessera.tile_wfc(sample, outSize, seed)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sample</param_name><param_description>Carte d'exemple numerique.</param_description></param_input_item>
    <param_input_item><param_name>outSize</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>Carte synthetisee utilisant les valeurs de sample.</param_description></param_output_item></param_output>
  <description><p>Apprend les adjacences horizontales et verticales immediates d'un exemple et synthetise une nouvelle carte aux voisins compatibles.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[sample = [1 1 2; 1 2 2; 3 3 2];
R = tessera.tile_wfc(sample, [32 32], 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
