  <language>fr_FR</language>
  <keyword>tessera.advect_curl</keyword>
  <short_description>Advection de particules par bruit curl.</short_description>
  <syntax><syntax_item>paths = tessera.advect_curl(points, steps)</syntax_item><syntax_item>paths = tessera.advect_curl(points, steps, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>points</param_name><param_description>Positions normalisees N-par-2 dans [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>steps</param_name><param_description>Nombre d'etapes d'integration.</param_description></param_input_item>
    <param_input_item><param_name>dt</param_name><param_description>Pas d'integration (defaut 0.02).</param_description></param_input_item>
    <param_input_item><param_name>size</param_name><param_description>Taille du champ curl (defaut 128).</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Frequence du bruit (defaut 8).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine du bruit (defaut 0).</param_description></param_input_item>
    <param_input_item><param_name>periodic</param_name><param_description>Reboucler aux bords du champ (defaut true).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>paths</param_name><param_description>Positions de taille (steps+1)-par-particules-par-2, points initiaux inclus.</param_description></param_output_item></param_output>
  <description><p>Fait avancer des particules dans le champ de vecteurs sans divergence produit par tessera.curl. Le resultat peut etre trace ou anime directement.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[points = tessera.poisson_disk([64 64], 80, 5);
paths = tessera.advect_curl(points, 80, 'seed', 2);
plot(squeeze(paths(:, :, 1)), squeeze(paths(:, :, 2))); axis equal tight]]></example_item_data></example_item></examples>
