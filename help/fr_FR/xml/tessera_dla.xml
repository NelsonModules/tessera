  <language>fr_FR</language>
  <keyword>tessera.dla</keyword>
  <short_description>Agregation limitee par diffusion.</short_description>
  <syntax><syntax_item>R = tessera.dla(sz)</syntax_item><syntax_item>R = tessera.dla(sz, particles, seed)</syntax_item><syntax_item>R = tessera.dla(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Taille de sortie : scalaire ou [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>particles</param_name><param_description>Nombre de marcheurs aleatoires a agreger (defaut 500).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Graine pseudo-aleatoire (defaut 0).</param_description></param_input_item>
    <param_input_item><param_name>obstacles</param_name><param_description>Matrice binaire de cellules occupees qui bloquent les marcheurs.</param_description></param_input_item>
    <param_input_item><param_name>seeds</param_name><param_description>Coordonnees N-par-2 des graines ; plusieurs amas peuvent demarrer ensemble.</param_description></param_input_item>
    <param_input_item><param_name>direction</param_name><param_description>Direction d'attraction a deux elements pour orienter les marcheurs.</param_description></param_input_item>
    <param_input_item><param_name>periodic</param_name><param_description>Reboucler les marcheurs sur les bords (defaut false).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>Image binaire de l'agregat.</param_description></param_output_item></param_output>
  <description><p>Fait croitre un amas depuis une graine centrale par marcheurs aleatoires qui se collent au contact de l'agregat.</p>
  <p><img src="../images/dla.svg" align="middle" /></p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>exemple 1</example_item_description><example_item_data><![CDATA[R = tessera.dla(128, 1000, 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
