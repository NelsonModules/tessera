  <keyword>tessera.gameoflife</keyword>
  <short_description>Conway's game of life.</short_description>
  <syntax>
    <syntax_item>G = tessera.gameoflife(grid)</syntax_item>
    <syntax_item>G = tessera.gameoflife(grid, generations)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>grid</param_name>
      <param_description>Initial state, a 0/1 (or logical) matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>generations</param_name>
      <param_description>Number of steps to advance (default 1).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>G</param_name>
      <param_description>The grid after the requested number of generations.</param_description>
    </param_output_item>
  </param_output>
  <description><p>Advance Conway's game of life on a toroidal (wrap-around) grid. A live cell survives with two or three live neighbors; a dead cell is born with exactly three. Classic for emergent patterns, gliders and oscillators.</p>
  <p><img src="../images/gameoflife.svg" align="middle" /></p></description>
  <used_function></used_function>
  <bibliography>M. Hendrikx, S. Meijer, J. van der Velden, A. Iosup, Procedural Content Generation for Games: A Survey, ACM Transactions on Multimedia Computing, Communications and Applications 9(1), 2013. DOI 10.1145/2422956.2422957.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>example 1</example_item_description>
      <example_item_data><![CDATA[g = zeros(32); g(16, 15:17) = 1;
g = tessera.gameoflife(g, 1);
spy(g)]]></example_item_data>
    </example_item>
  </examples>
