  <language>en_US</language>
  <keyword>tessera.perlin3</keyword>
  <short_description>3-D Perlin gradient noise.</short_description>
  <syntax>
    <syntax_item>V = tessera.perlin3(sz)</syntax_item>
    <syntax_item>V = tessera.perlin3(sz, frequency, seed)</syntax_item>
    <syntax_item>V = tessera.perlin3(sz, 'frequency', f, 'seed', s, 'seamless', tf)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Volume size: a scalar or [rows cols planes].</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Base frequency (default 8).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Pseudo-random seed (default 0).</param_description></param_input_item>
    <param_input_item><param_name>seamless</param_name><param_description>If true, opposite volume faces are matched.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>V</param_name><param_description>A rows-by-cols-by-planes double volume normalized to [0, 1].</param_description></param_output_item></param_output>
  <description><p>Generate a coherent 3-D Perlin field for volumetric textures or animation through the third dimension.</p></description>
  <used_function></used_function>
  <bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[V = tessera.perlin3([64 64 16], 'seed', 3, 'seamless', true);
imagesc(V(:, :, 1)); axis image off]]></example_item_data></example_item></examples>
