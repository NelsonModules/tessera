  <keyword>tessera.advect_curl</keyword>
  <short_description>Particle advection through curl noise.</short_description>
  <syntax><syntax_item>paths = tessera.advect_curl(points, steps)</syntax_item><syntax_item>paths = tessera.advect_curl(points, steps, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>points</param_name><param_description>N-by-2 normalized particle positions in [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>steps</param_name><param_description>Number of integration steps.</param_description></param_input_item>
    <param_input_item><param_name>dt</param_name><param_description>Integration step size (default 0.02).</param_description></param_input_item>
    <param_input_item><param_name>size</param_name><param_description>Curl field size (default 128).</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Noise frequency (default 8).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Noise seed (default 0).</param_description></param_input_item>
    <param_input_item><param_name>periodic</param_name><param_description>Wrap positions at the field boundary (default true).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>paths</param_name><param_description>(steps+1)-by-particles-by-2 positions, including the initial points.</param_description></param_output_item></param_output>
  <description><p>Advect particles through the divergence-free vector field generated by tessera.curl. The result is ready for plotting or animation.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[points = tessera.poisson_disk([64 64], 80, 5);
paths = tessera.advect_curl(points, 80, 'seed', 2);
plot(squeeze(paths(:, :, 1)), squeeze(paths(:, :, 2))); axis equal tight]]></example_item_data></example_item></examples>
