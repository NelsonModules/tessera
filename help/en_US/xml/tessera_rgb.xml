  <language>en_US</language>
  <keyword>tessera.rgb</keyword>
  <short_description>Map a scalar field to RGB.</short_description>
  <syntax><syntax_item>RGB = tessera.rgb(field)</syntax_item><syntax_item>RGB = tessera.rgb(field, cmap)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>field</param_name><param_description>Scalar field, usually normalized to [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>cmap</param_name><param_description>Colormap matrix or colormap name (default terrain).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>RGB</param_name><param_description>An RGB array with a final channel dimension of length 3.</param_description></param_output_item></param_output>
  <description><p>Clamp a scalar field to [0, 1], index a colormap, and return the RGB image directly.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[R = tessera.rgb(tessera.fbm(256, 'seed', 1), 'terrain');
imshow(R)]]></example_item_data></example_item></examples>
