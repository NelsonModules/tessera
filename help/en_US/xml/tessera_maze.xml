  <language>en_US</language>
  <keyword>tessera.maze</keyword>
  <short_description>Recursive-backtracker maze.</short_description>
  <syntax>
    <syntax_item>R = tessera.maze(rows, cols)</syntax_item>
    <syntax_item>R = tessera.maze(rows, cols, seed)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>rows</param_name>
      <param_description>Number of maze cells vertically.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>cols</param_name>
      <param_description>Number of maze cells horizontally.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>seed</param_name>
      <param_description>Seed of the pseudo-random generator (default 0). The same seed reproduces the same field.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>A (2*rows+1)-by-(2*cols+1) map, 1 = wall, 0 = passage.</param_description>
    </param_output_item>
  </param_output>
  <description><p>Generate a perfect maze (one unique path between any two cells, no loops) with the recursive-backtracker algorithm. Walls sit on the even rows and columns of the returned grid; passages on the odd ones.</p>
  <p><img src="../images/maze.svg" align="middle" /></p></description>
  <used_function></used_function>
  <bibliography>M. Hendrikx, S. Meijer, J. van der Velden, A. Iosup, Procedural Content Generation for Games: A Survey, ACM Transactions on Multimedia Computing, Communications and Applications 9(1), 2013. DOI 10.1145/2422956.2422957.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>example 1</example_item_description>
      <example_item_data><![CDATA[R = tessera.maze(25, 25, 1);
imagesc(R); axis image off; colormap(gray(2))]]></example_item_data>
    </example_item>
  </examples>
