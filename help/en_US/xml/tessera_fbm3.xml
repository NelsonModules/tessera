  <language>en_US</language>
  <keyword>tessera.fbm3</keyword>
  <short_description>3-D fractional Brownian motion.</short_description>
  <syntax>
    <syntax_item>V = tessera.fbm3(sz)</syntax_item>
    <syntax_item>V = tessera.fbm3(sz, octaves, seed)</syntax_item>
    <syntax_item>V = tessera.fbm3(sz, 'octaves', o, 'frequency', f, 'lacunarity', l, 'gain', g, 'seed', s, 'seamless', tf)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Volume size: a scalar or [rows cols planes].</param_description></param_input_item>
    <param_input_item><param_name>octaves</param_name><param_description>Number of octaves (default 5).</param_description></param_input_item>
    <param_input_item><param_name>frequency</param_name><param_description>Base frequency (default 4).</param_description></param_input_item>
    <param_input_item><param_name>lacunarity</param_name><param_description>Frequency multiplier per octave (default 2).</param_description></param_input_item>
    <param_input_item><param_name>gain</param_name><param_description>Amplitude multiplier per octave (default 0.5).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Pseudo-random seed (default 0).</param_description></param_input_item>
    <param_input_item><param_name>seamless</param_name><param_description>If true, opposite volume faces are matched.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>V</param_name><param_description>A rows-by-cols-by-planes double volume normalized to [0, 1].</param_description></param_output_item></param_output>
  <description><p>Sum several octaves of 3-D coherent noise for volumetric terrain, clouds, or time-sliced animation.</p>
  <p><img src="../images/fbm3.svg" align="middle" /></p></description>
  <used_function></used_function>
  <bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[V = tessera.fbm3([64 64 24], 'octaves', 5, 'seed', 42, 'seamless', true);
imagesc(V(:, :, 1)); axis image off]]></example_item_data></example_item></examples>
