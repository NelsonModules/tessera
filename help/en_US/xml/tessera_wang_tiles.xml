  <keyword>tessera.wang_tiles</keyword>
  <short_description>Wang tile identifiers with matching edges.</short_description>
  <syntax><syntax_item>T = tessera.wang_tiles(sz)</syntax_item><syntax_item>T = tessera.wang_tiles(sz, colors, seed)</syntax_item><syntax_item>T = tessera.wang_tiles(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Output size: a scalar or [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>colors</param_name><param_description>Number of edge colors (default 3).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Pseudo-random seed (default 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>T</param_name><param_description>Tile identifiers encoding west, east, north and south edge colors.</param_description></param_output_item></param_output>
  <description><p>Generate a Wang-tile map where adjacent edge colors match by construction.</p>
  <p><img src="../images/wang_tiles.svg" align="middle" /></p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[T = tessera.wang_tiles([32 32], 4, 1);
imagesc(T); axis image off]]></example_item_data></example_item></examples>
