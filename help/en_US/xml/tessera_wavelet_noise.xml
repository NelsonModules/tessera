  <keyword>tessera.wavelet_noise</keyword>
  <short_description>Band-pass wavelet-style noise.</short_description>
  <syntax><syntax_item>R = tessera.wavelet_noise(sz)</syntax_item><syntax_item>R = tessera.wavelet_noise(sz, octaves, seed)</syntax_item><syntax_item>R = tessera.wavelet_noise(sz, 'name', value, ...)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>sz</param_name><param_description>Output size: a scalar or [rows cols].</param_description></param_input_item>
    <param_input_item><param_name>octaves</param_name><param_description>Number of octave differences (default 4).</param_description></param_input_item>
    <param_input_item><param_name>seed</param_name><param_description>Pseudo-random seed (default 0).</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>R</param_name><param_description>A double field normalized to [0, 1].</param_description></param_output_item></param_output>
  <description><p>Build band-pass noise by summing differences between adjacent value-noise octaves.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[R = tessera.wavelet_noise(256, 4, 1);
imagesc(R); axis image off]]></example_item_data></example_item></examples>
