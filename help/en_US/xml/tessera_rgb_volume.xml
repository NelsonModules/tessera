  <keyword>tessera.rgb_volume</keyword>
  <short_description>Map a scalar volume to RGB.</short_description>
  <syntax><syntax_item>RGB = tessera.rgb_volume(volume)</syntax_item><syntax_item>RGB = tessera.rgb_volume(volume, cmap)</syntax_item></syntax>
  <param_input><param_input_item><param_name>volume</param_name><param_description>Rows-by-cols-by-planes scalar volume.</param_description></param_input_item><param_input_item><param_name>cmap</param_name><param_description>Colormap matrix or name.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>RGB</param_name><param_description>Rows-by-cols-by-planes-by-3 RGB volume.</param_description></param_output_item></param_output>
  <description><p>Apply tessera.rgb independently to every plane of a 3-D scalar volume.</p></description>
  <used_function></used_function><bibliography></bibliography>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>example 1</example_item_description><example_item_data><![CDATA[V = tessera.fbm3([64 64 12], 'seed', 1);
RGB = tessera.rgb_volume(V, 'terrain');]]></example_item_data></example_item></examples>
